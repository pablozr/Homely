PROJECT_NAME=Homely API
API_VERSION=0.1.0
ENVIRONMENT=development
API_PORT=8000

DB_HOST=localhost
DB_PORT=5432
DB_USER=homely
DB_PASSWORD=homely
DB_NAME=homely

# Use a unique random value with at least 32 characters outside development.
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Local development email capture. Mailpit UI: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@homely.local
SMTP_TIMEOUT_SECONDS=10
PUSH_ENABLED=false

# Mobile magic link. The deep link must match the app scheme registered in the mobile build.
MAGIC_LINK_EXPIRE_MINUTES=15
MAGIC_LINK_DEEP_LINK_BASE=homely://auth
MAGIC_LINK_EMAIL_RATE_LIMIT=3
MAGIC_LINK_EMAIL_RATE_WINDOW_MINUTES=15
MAGIC_LINK_IP_RATE_LIMIT=10
MAGIC_LINK_IP_RATE_WINDOW_MINUTES=60
MAGIC_LINK_EXCHANGE_IP_RATE_LIMIT=10
MAGIC_LINK_EXCHANGE_IP_RATE_WINDOW_MINUTES=15
